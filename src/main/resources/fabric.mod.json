  "authors": ["you"],
  "license": "MIT",
  "icon": "assets/uranium/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.uranium.UraniumClient"]
  },
  "mixins": [
    {
      "config": "uranium.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
